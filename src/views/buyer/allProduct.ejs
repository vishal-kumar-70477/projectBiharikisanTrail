<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Bihari Kishan — Browse Crops</title>
<link rel="stylesheet" href="/css/buyerCss/allProduct.css" />
</head>
<body>

  <div class="app-shell">

    <!-- ================= SIDEBAR ================= -->
    <aside class="sidebar" id="sidebar">
      <div class="sidebar-brand">
        <svg class="brand-icon" viewBox="0 0 24 24" fill="none" stroke="#2F7A4A" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2c1 3 1 5 0 8-1-3-1-5 0-8Z" fill="#C99A3E" stroke="none"></path><path d="M12 22V10"></path><path d="M12 10c-2-1-4-1-6 1 2 3 4 3 6 1Z"></path><path d="M12 10c2-1 4-1 6 1-2 3-4 3-6 1Z"></path></svg>
        <div class="sidebar-brand-text">
          <p class="sidebar-brand-name">BIHARI KISAN</p>
          <p class="sidebar-brand-sub">Buyer Dashboard</p>
        </div>
      </div>
      <hr class="sidebar-divider" />

      <ul class="sidebar-nav">
        <li>
          <a href="/buyerDash" class="nav-link">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"></rect><rect x="14" y="3" width="7" height="7" rx="1.5"></rect><rect x="14" y="14" width="7" height="7" rx="1.5"></rect><rect x="3" y="14" width="7" height="7" rx="1.5"></rect></svg>
            Dashboard
          </a>
        </li>
        <li>
          <a href="/buyerDash" class="nav-link active">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 8h14l-1.5 10.5a2 2 0 0 1-2 1.5H8.5a2 2 0 0 1-2-1.5L5 8Z"></path><path d="M9 8V6a3 3 0 0 1 6 0v2"></path></svg>
            Browse Crops
          </a>
        </li>
        <li>
          <a href="/buyer/myorder" class="nav-link">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="3" width="12" height="18" rx="2"></rect><path d="M9 3v2h6V3"></path><path d="M9 12h6M9 16h4"></path></svg>
            My Orders
          </a>
        </li>
        <li>
          <a href="/biharikisan/buyer/saved-sellers" class="nav-link">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3"></circle><path d="M2 20c0-3.3 3-5 7-5s7 1.7 7 5"></path><circle cx="17" cy="8" r="2.5"></circle><path d="M16 15c2.6.3 5 1.8 5 5"></path></svg>
            Saved Sellers
          </a>
        </li>
        <li>
          <a href="/biharikisan/buyer/payments" class="nav-link">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="6" width="18" height="13" rx="2"></rect><path d="M3 10h18"></path><path d="M17 14h1.5"></path></svg>
            Payments
          </a>
        </li>
        <li>
          <a href="/biharikisan/buyer/track-delivery" class="nav-link">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="7" width="13" height="10" rx="1.5"></rect><path d="M14 10h4l3 3v4h-7"></path><circle cx="5.5" cy="18.5" r="1.7"></circle><circle cx="17.5" cy="18.5" r="1.7"></circle></svg>
            Track Delivery
          </a>
        </li>
        <li>
          <a href="/biharikisan/buyer/help" class="nav-link">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><circle cx="12" cy="12" r="3.2"></circle><path d="m6.3 6.3 3.5 3.5M17.7 6.3l-3.5 3.5M6.3 17.7l3.5-3.5M17.7 17.7l-3.5-3.5"></path></svg>
            Help &amp; Support
          </a>
        </li>
        <li>
          <a href="/biharikisan/buyer/settings" class="nav-link">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.6V21a2 2 0 1 1-4 0v-.2a1.7 1.7 0 0 0-1-1.6 1.7 1.7 0 0 0-1.9.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.9 1.7 1.7 0 0 0-1.6-1H3a2 2 0 1 1 0-4h.2a1.7 1.7 0 0 0 1.6-1 1.7 1.7 0 0 0-.3-1.9l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.9.3H9a1.7 1.7 0 0 0 1-1.6V3a2 2 0 1 1 4 0v.2a1.7 1.7 0 0 0 1 1.6 1.7 1.7 0 0 0 1.9-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.9V9a1.7 1.7 0 0 0 1.6 1H21a2 2 0 1 1 0 4h-.2a1.7 1.7 0 0 0-1.6 1Z"></path></svg>
            Settings
          </a>
        </li>
      </ul>

      <div class="sidebar-footer">
        <hr class="sidebar-divider" />
        <a href="/dash" class="logout-link">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
          Logout
        </a>
      </div>
    </aside>

    <!-- Dark backdrop shown behind the sidebar when it is open on mobile -->
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <!-- ================= CONTENT ================= -->
    <div class="content-col">

      <header class="topbar">
        <div class="topbar-inner">
          <!-- Hamburger menu button, visible only on mobile widths -->
          <button type="button" class="menu-btn" id="menuBtn" aria-label="Open menu">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <line x1="3" y1="12" x2="21" y2="12"></line>
              <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
          </button>

          <div class="search-box">
            <svg class="icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            <input type="text" id="searchInput" placeholder="Search crops, sellers..." />
          </div>
          <div class="topbar-actions">
            <button type="button" class="bell-btn" aria-label="Notifications">
              <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 5 2 6 2 6H4s2-1 2-6Z"></path><path d="M10 21a2 2 0 0 0 4 0"></path></svg>
              <span class="bell-dot"></span>
            </button>
            <div class="avatar-chip" id="userAvatar"><%= data.userName
            .split(" ")
            .map(name => name[0])
            .join("")
            .substring(0, 2)
            .toUpperCase() %></div>
          </div>
        </div>
      </header>

      <main class="main">
        <div id="errorBanner" class="error-banner hidden"></div>

        <div id="skeletonGrid" class="grid"></div>

        <div id="emptyState" class="empty-state hidden">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#8A8470" stroke-width="1.5"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"></path><path d="m3.3 7 8.7 5 8.7-5"></path><path d="M12 22V12"></path></svg>
          <p class="empty-title" id="emptyTitle">Abhi koi crop listed nahi hai</p>
          <p class="empty-sub" id="emptySub">Farmers ke listing karte hi yahan dikhega</p>
        </div>

        <div id="productGrid" class="grid hidden"></div>
      </main>

    </div>
  </div>

  <script src="/js/buyerJs/allProduct.js"></script>
</body>
</html>
