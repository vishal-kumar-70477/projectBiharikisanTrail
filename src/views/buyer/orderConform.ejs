<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Order Placed — Bihari Kisan</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">

  <link
    href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Inter:wght@400;500;600;700;800&family=Noto+Sans+Devanagari:wght@500;600&display=swap"
    rel="stylesheet"
  >

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
  >

  <link rel="stylesheet" href="/css/buyerCss/orderConform.css">
</head>

<body>

  <header class="bk-header">
    <div class="bk-header__inner">

      <a class="bk-logo" href="product-details.html" aria-label="Bihari Kisan home">
        <span class="bk-logo__icon">
          <i class="fa-solid fa-seedling"></i>
        </span>

        <span class="bk-logo__text">
          BIHARI<em>KISAN</em>
        </span>
      </a>

      <span class="bk-avatar">VK</span>

    </div>
  </header>


  <main class="bk-page">

    <!-- ================= HERO ================= -->

    <section class="bk-hero">

      <div class="bk-check" aria-hidden="true">
        <svg viewBox="0 0 100 100">
          <circle class="bk-check__ring" cx="50" cy="50" r="45" />
          <path class="bk-check__mark" d="M28 52 L43 66 L74 34" />
        </svg>
      </div>

      <h1>Order Placed Successfully!</h1>

      <p class="bk-hero__hindi" lang="hi">
        धन्यवाद! आपका ऑर्डर किसान तक पहुँच गया है।
      </p>

      <div class="bk-hero__meta">

        <span>
          Order ID:
          <strong id="orderId">BK-2026-001245</strong>
        </span>

        <span class="bk-dot-sep">•</span>

        <span>
          Placed on
          <strong id="orderDate">16 August 2026</strong>
        </span>

      </div>

    </section>


    <div class="bk-layout">

      <div class="bk-main-col">

        <!-- ================= FARMER INFO ================= -->

        <section class="bk-card bk-farmer-card">

          <div class="bk-farmer-card__badge">
            <i class="fa-solid fa-hand-holding-heart"></i>
            Your order is directly supporting a farmer
          </div>


          <div class="bk-farmer-card__body">

            <!-- IMPORTANT:
                 Avatar ab JS se sellerName ke according generate hoga
            -->
            <span
              class="bk-farmer-card__avatar"
              id="farmerAvatar"
            >
              PK
            </span>


            <div>

              <strong id="farmerName">
                Piyush Kumar
              </strong>

              <span id="farmerLocation">
                <i class="fa-solid fa-location-dot"></i>
                Bihar, India
              </span>

            </div>


            <div class="bk-farmer-card__product">

              <span id="productName">
                Desi Aloo
              </span>

              <span id="productQty">
                5 KG
              </span>

            </div>

          </div>

        </section>


        <!-- ================= DELIVERY TIMELINE ================= -->

        <section class="bk-card">

          <h2>
            <i class="fa-solid fa-route"></i>
            Delivery Timeline
          </h2>


          <ol class="bk-timeline">

            <li class="is-done">
              <span class="bk-timeline__dot">
                <i class="fa-solid fa-check"></i>
              </span>

              <span class="bk-timeline__label">
                Order Confirmed
              </span>
            </li>


            <li>
              <span class="bk-timeline__dot"></span>

              <span class="bk-timeline__label">
                Farmer Preparing Produce
              </span>
            </li>


            <li>
              <span class="bk-timeline__dot"></span>

              <span class="bk-timeline__label">
                Picked Up
              </span>
            </li>


            <li>
              <span class="bk-timeline__dot"></span>

              <span class="bk-timeline__label">
                Out for Delivery
              </span>
            </li>


            <li>
              <span class="bk-timeline__dot"></span>

              <span class="bk-timeline__label">
                Delivered
              </span>
            </li>

          </ol>


          <p class="bk-eta">
            <i class="fa-solid fa-truck"></i>
            Expected delivery:
            <strong>18–20 August 2026</strong>
          </p>

        </section>


        <!-- ================= PAYMENT ================= -->

        <section class="bk-card">

          <h2>
            <i class="fa-solid fa-receipt"></i>
            Payment Information
          </h2>


          <div class="bk-payment-info">

            <div>
              <span>Payment Method</span>

              <strong id="paymentMethod">
                UPI
              </strong>
            </div>


            <div>
              <span>Amount Paid</span>

              <strong id="amountPaid">
                ₹1050
              </strong>
            </div>


            <div>
              <span>Payment Status</span>

              <strong class="bk-status-success">
                <i class="fa-solid fa-circle-check"></i>
                Successful
              </strong>
            </div>

          </div>

        </section>

      </div>

    </div>


    <!-- ================= ACTIONS ================= -->

    <div class="bk-actions">

      <a href="#" class="bk-btn bk-btn--outline">
        <i class="fa-solid fa-route"></i>
        Track My Order
      </a>


      <a href="#" class="bk-btn bk-btn--outline">
        <i class="fa-solid fa-list"></i>
        View My Orders
      </a>


      <a href="/allProduct" class="bk-btn bk-btn--primary">
        <i class="fa-solid fa-basket-shopping"></i>
        Continue Shopping
      </a>

    </div>


    <!-- ================= MESSAGE ================= -->

    <section class="bk-message">

      <p lang="hi">
        आपकी हर खरीद एक किसान के सपने को आगे बढ़ाती है।
      </p>

      <p class="bk-message__tagline" lang="hi">
        एक बीज = 100% Money
      </p>

    </section>

  </main>


  <!-- ================= FOOTER ================= -->

  <footer class="bk-footer">

    <p>
      <span lang="hi">
        एक बीज = 100% Money
      </span>
      · सीधे किसान से • सही दाम • भरोसे के साथ
    </p>

  </footer>


  <script src="/js/buyerJs/orderConform.js"></script>

</body>

</html>