<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Desi Aloo — Bihari Kisan</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,600;9..144,700&family=Inter:wght@400;500;600;700;800&family=Noto+Sans+Devanagari:wght@500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
<link rel="stylesheet" href="/css/buyerCss/viewProduct.css">
</head>
<body>

<header class="bk-header">
  <div class="bk-header__inner">
    <a class="bk-logo" href="product-details.html" aria-label="Bihari Kisan home">
      <span class="bk-logo__icon"><i class="fa-solid fa-seedling"></i></span>
      <span class="bk-logo__text">BIHARI<em>KISAN</em></span>
    </a>

    <form class="bk-search" role="search" aria-label="Search crops">
      <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
      <input type="search" placeholder="Search crops, farmers, villages..." aria-label="Search crops, farmers, villages">
    </form>

    <div class="bk-header__actions">
      <button class="bk-icon-btn" aria-label="Notifications">
        <i class="fa-regular fa-bell"></i>
        <span class="bk-dot" aria-hidden="true"></span>
      </button>
      <a href="/cart" class="bk-icon-btn" aria-label="Cart">
     <i class="fa-solid fa-basket-shopping"></i>
     <span id="cartBadge" class="bk-badge">0</span>
     </a>
      <div class="bk-profile">
        <span class="bk-avatar"><%= data.userName
            .split(" ")
            .map(name => name[0])
            .join("")
            .substring(0, 2)
            .toUpperCase() %></span>
        <span class="bk-profile__name"><%= data.userName %></span>
      </div>
    </div>
  </div>
</header>

<main class="bk-page">

  <nav class="bk-breadcrumb" aria-label="Breadcrumb">
    <a href="#">Home</a>
    <i class="fa-solid fa-chevron-right"></i>
    <a href="#">Browse Crops</a>
    <i class="fa-solid fa-chevron-right"></i>
    <a href="#">Vegetables</a>
    <i class="fa-solid fa-chevron-right"></i>
    <span aria-current="page">Desi Aloo</span>
  </nav>

  <section class="bk-product">

    <div class="bk-gallery">
      <div class="bk-gallery__main">
        <img id="mainImage" src="" alt="">
        <span class="bk-ribbon"><i class="fa-solid fa-leaf"></i> Farm Fresh</span>
      </div>
     
    </div>

    <div class="bk-info">
      <div class="bk-info__top">
        <h1 class="bk-product__name">Desi Aloo <span class="bk-unit-tag">Potato</span></h1>
        <div class="bk-rating">
          <i class="fa-solid fa-star"></i> 4.7
          <span class="bk-rating__count">(318 buyers)</span>
        </div>
      </div>

      <a class="bk-seller" href="#">

        <div class="bk-seller__avatar">
            <%= data.farmerName
                .split(" ")
                .map(name => name[0])
                .join("")
                .substring(0, 2)
                .toUpperCase() %>
        </div>

        <div class="bk-seller__meta">
          <span class="bk-seller__name">
              <%= data.farmerName
                  .split(" ")
                  .map(word => word.charAt(0).toUpperCase() + word.slice(1).toLowerCase())
                  .join(" ") %>

              <i class="fa-solid fa-circle-check bk-verified"
                 title="Farm Verified"></i>
          </span>

          <span class="bk-seller__loc">
              <i class="fa-solid fa-location-dot"></i>
              <%= data.farmerAddress %>
          </span>
        </div>

        <span class="bk-seller__cta">
            Visit Farm Store
            <i class="fa-solid fa-arrow-right"></i>
        </span>

    </a>
      <div class="bk-price-block">
        <span class="bk-price">₹200<span class="bk-price__unit">/ KG</span></span>
        <span class="bk-stock"><i class="fa-solid fa-warehouse"></i> 2,999 KG available</span>
      </div>

      <ul class="bk-features">
        <li><i class="fa-solid fa-leaf"></i> Freshly harvested this week</li>
        <li><i class="fa-solid fa-truck-fast"></i> Direct from farmer — no middlemen</li>
        <li><i class="fa-solid fa-magnifying-glass-chart"></i> Quality checked by Bihari Kisan</li>
        <li><i class="fa-solid fa-house-chimney"></i> Grown by a local, verified farmer</li>
      </ul>

      <div class="bk-quantity">
        <span class="bk-quantity__label">Quantity</span>
        <div class="bk-stepper">
          <button id="qtyMinus" class="bk-stepper__btn" aria-label="Decrease quantity">−</button>
          <span id="qtyValue" class="bk-stepper__value">1</span>
          <button id="qtyPlus" class="bk-stepper__btn" aria-label="Increase quantity">+</button>
        </div>
        <span class="bk-quantity__unit">KG</span>
      </div>

      <div class="bk-total-row">
        <span>Quantity: <strong id="qtySummary">1 KG</strong></span>
        <span class="bk-total">Total: <strong id="totalValue">₹200</strong></span>
      </div>

      <div class="bk-delivery-note">
        <i class="fa-solid fa-truck"></i>
        <div>
          <strong>Delivery in 2–4 working days</strong>
          <span>Delivering to Asansol, West Bengal — 713325</span>
        </div>
      </div>

      <div class="bk-actions">
        <button id="addToCartBtn" class="bk-btn bk-btn--outline">
          <i class="fa-solid fa-basket-shopping"></i> Add to Cart
        </button>
        <button id="buyNowBtn" class="bk-btn bk-btn--primary">
          Buy Now <i class="fa-solid fa-arrow-right"></i>
        </button>
      </div>
    </div>
  </section>

  <section class="bk-trust" aria-label="Why buy from Bihari Kisan">
    <h2 class="bk-trust__title">Why buyers trust Bihari Kisan</h2>
    <div class="bk-trust__grid">
      <div class="bk-trust__card">
        <i class="fa-solid fa-circle-check"></i>
        <h3>Verified Farmer</h3>
        <p>Every seller's land and identity is checked before they can list produce.</p>
      </div>
      <div class="bk-trust__card">
        <i class="fa-solid fa-leaf"></i>
        <h3>Fresh Farm Produce</h3>
        <p>Crops are listed within days of harvest — straight from the field to you.</p>
      </div>
      <div class="bk-trust__card">
        <i class="fa-solid fa-lock"></i>
        <h3>Secure Payment</h3>
        <p>UPI, cards and COD — your money is protected until delivery is confirmed.</p>
      </div>
      <div class="bk-trust__card">
        <i class="fa-solid fa-magnifying-glass-chart"></i>
        <h3>Quality Checked</h3>
        <p>Produce is spot-checked for freshness and grading before dispatch.</p>
      </div>
      <div class="bk-trust__card">
        <i class="fa-solid fa-route"></i>
        <h3>Delivery Tracking</h3>
        <p>Follow your order from the farm gate to your doorstep, in real time.</p>
      </div>
    </div>
  </section>

</main>

<footer class="bk-footer">
  <p><span lang="hi">एक बीज = 100% Money</span> · सीधे किसान से • सही दाम • भरोसे के साथ</p>
</footer>
<script>
    const PRODUCT_ID = "<%= productId %>";
</script>
<script src="/js/buyerJs/viewProduct.js"></script>
</body>
</html>
