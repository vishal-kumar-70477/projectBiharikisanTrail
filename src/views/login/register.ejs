<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Bihari Kisan — एक बीज = 100% Money</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;1,9..144,500&family=Manrope:wght@400;500;600;700;800&family=Noto+Sans+Devanagari:wght@500;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/loginCss/register.css">
</head>
<body>

<div class="page">

  <!-- ============ HEADER ============ -->
  <header class="header">
    <div class="header__inner">
      <a class="brand" href="#" aria-label="Bihari Kisan home">
        <span class="brand__mark" aria-hidden="true">
          <svg viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M22 6C22 6 30 11 30 20C30 27 26 31 22 33C18 31 14 27 14 20C14 11 22 6 22 6Z" fill="#F5A623"/>
            <path d="M22 6C22 6 30 11 30 20C30 27 26 31 22 33V6Z" fill="#176B2C"/>
            <path d="M22 33V38" stroke="#26352A" stroke-width="2" stroke-linecap="round"/>
            <path d="M22 36C19 36 17 34.5 16 33" stroke="#26352A" stroke-width="1.6" stroke-linecap="round"/>
            <path d="M22 36C25 36 27 34.5 28 33" stroke="#26352A" stroke-width="1.6" stroke-linecap="round"/>
          </svg>
        </span>
        <span class="brand__word">
          <span class="brand__name">BIHARI <em>KISAN</em></span>
        </span>
      </a>

      <nav class="nav" aria-label="Primary">
        <a href="#" class="nav__link">About</a>
        <a href="#" class="nav__link">How It Works</a>
        <a href="#" class="nav__link">Contact</a>
      </nav>

      <button class="btn btn--dark btn--pill nav__cta" id="navAuthBtn" type="button">Login / Register</button>
    </div>
  </header>

  <!-- ============ AUTH FRAME ============ -->
  <main class="frame">
    <div class="frame__panel">

      <!-- LEFT : FORM -->
      <section class="auth" aria-label="Authentication">

        <div class="auth__scroll">

          <div class="auth__top">
            <p class="eyebrow">बिहारी किसान</p>
            <p class="tagline">एक बीज <span class="tagline__eq">=</span> 100% Money</p>
          </div>

          <!-- Tabs -->
          <div class="tabs" role="tablist" aria-label="Choose login or register">
            <button class="tabs__btn is-active" id="tabLogin" role="tab" aria-selected="true" aria-controls="panelLogin">Login</button>
            <button class="tabs__btn" id="tabRegister" role="tab" aria-selected="false" aria-controls="panelRegister">Register</button>
            <span class="tabs__thumb" aria-hidden="true"></span>
          </div>

          <!-- ===================== LOGIN PANEL ===================== -->
          <div class="panel is-active" id="panelLogin" role="tabpanel" aria-labelledby="tabLogin">
            <h1 class="h1">Welcome Back, Kisan <span aria-hidden="true">👋</span></h1>
            <p class="sub">Login to manage your farming journey.</p>

            <form class="form" id="loginForm" novalidate>
              <p class="form__error" id="loginError" role="alert" hidden></p>
              <label class="field">
                <span class="field__label">Mobile number or email</span>
                <input class="field__input" type="text" name="loginId" placeholder="98xxxxxxxx or you@example.com" required>
              </label>

              <label class="field">
                <span class="field__label">Password</span>
                <div class="field__pw">
                  <input class="field__input" type="password" name="password" placeholder="Enter your password" required>
                  <button type="button" class="field__eye" data-toggle-pw aria-label="Show password">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M1.5 10S4.5 4 10 4s8.5 6 8.5 6-3 6-8.5 6-8.5-6-8.5-6Z" stroke="currentColor" stroke-width="1.4"/><circle cx="10" cy="10" r="2.5" stroke="currentColor" stroke-width="1.4"/></svg>
                  </button>
                </div>
              </label>

              <div class="form__row form__row--between">
                <label class="check">
                  <input type="checkbox" name="remember">
                  <span>Remember me</span>
                </label>
                <a href="#" class="link">Forgot password?</a>
              </div>

              <button class="btn btn--dark btn--block" type="submit">Log In</button>
            </form>

            <p class="switch">New to Bihari Kisan? <button type="button" class="link link--strong" id="goRegister">Create an account</button></p>
          </div>

          <!-- ===================== REGISTER PANEL ===================== -->
          <div class="panel" id="panelRegister" role="tabpanel" aria-labelledby="tabRegister">

            <!-- Progress -->
            <ol class="progress" id="progress" aria-label="Registration progress">
              <li class="progress__step is-active" data-step="1"><span class="progress__dot">1</span><span class="progress__label">Account</span></li>
              <li class="progress__step" data-step="2"><span class="progress__dot">2</span><span class="progress__label">Role</span></li>
              <li class="progress__step" data-step="3"><span class="progress__dot">3</span><span class="progress__label">Verify</span></li>
              <li class="progress__step" data-step="4"><span class="progress__dot">4</span><span class="progress__label">Done</span></li>
            </ol>

            <p class="form__error" id="formError" role="alert" hidden></p>

            <form class="form steps" id="registerForm" novalidate>

              <!-- STEP 1 : ACCOUNT + ADDRESS -->
              <div class="step is-active" data-step="1">
                <h1 class="h1">Join Bihari Kisan <span aria-hidden="true">🌾</span></h1>
                <p class="sub">Create your account and become part of India's smarter farming network.</p>

                <label class="field">
                  <span class="field__label">Full name</span>
                  <input class="field__input" type="text" name="fullName" placeholder="Enter your full name" required>
                </label>

                <div class="form__row form__row--split">
                  <label class="field">
                    <span class="field__label">Mobile number</span>
                    <input class="field__input" type="tel" name="mobile" placeholder="98xxxxxxxx" required>
                  </label>
                  <label class="field">
                    <span class="field__label">Email address</span>
                    <input class="field__input" type="email" name="email" placeholder="you@example.com" required>
                  </label>
                </div>

                <div class="form__row form__row--split">
                  <label class="field">
                    <span class="field__label">Village / Town</span>
                    <input class="field__input" type="text" name="village" placeholder="e.g. Bihta" required>
                  </label>
                  <label class="field">
                    <span class="field__label">District</span>
                    <input class="field__input" type="text" name="district" placeholder="e.g. Patna" required>
                  </label>
                </div>

                <div class="form__row form__row--split">
                  <label class="field">
                    <span class="field__label">State</span>
                    <input class="field__input" type="text" name="state" placeholder="e.g. Bihar" required>
                  </label>
                  <label class="field">
                    <span class="field__label">Password</span>
                    <input class="field__input" type="text" name="password" placeholder="e.g. 800001" required>
                  </label>
                </div>

                <button class="btn btn--dark btn--block" type="button" data-next>Continue</button>
              </div>

              <!-- STEP 2 : ROLE -->
              <div class="step" data-step="2">
                <h1 class="h1">Choose your role</h1>
                <p class="sub">Tell us how you'll use Bihari Kisan.</p>

                <div class="roles" role="radiogroup" aria-label="Select your role">
                  <button type="button" class="role-card role-card--seller" data-role="seller" role="radio" aria-checked="false">
                    <span class="role-card__check" aria-hidden="true">✓</span>
                    <span class="role-card__icon" aria-hidden="true">
                      <svg viewBox="0 0 40 40" fill="none"><path d="M20 6c6 4 10 9 10 15 0 6-4 10-10 12-6-2-10-6-10-12 0-6 4-11 10-15Z" stroke="#26352A" stroke-width="1.6"/><path d="M20 16v14" stroke="#26352A" stroke-width="1.6" stroke-linecap="round"/></svg>
                    </span>
                    <span class="role-card__title">Seller</span>
                    <span class="role-card__desc">Sell your harvest directly to verified buyers</span>
                  </button>

                  <button type="button" class="role-card role-card--buyer" data-role="buyer" role="radio" aria-checked="false">
                    <span class="role-card__check" aria-hidden="true">✓</span>
                    <span class="role-card__icon" aria-hidden="true">
                      <svg viewBox="0 0 40 40" fill="none"><path d="M11 15h18l-1.6 15.2a3 3 0 0 1-3 2.8H15.6a3 3 0 0 1-3-2.8L11 15Z" stroke="#26352A" stroke-width="1.6"/><path d="M15 15v-2a5 5 0 0 1 10 0v2" stroke="#26352A" stroke-width="1.6"/></svg>
                    </span>
                    <span class="role-card__title">Buyer</span>
                    <span class="role-card__desc">Source fresh produce at fair market prices</span>
                  </button>

                  <button type="button" class="role-card role-card--driver" data-role="driver" role="radio" aria-checked="false">
                    <span class="role-card__check" aria-hidden="true">✓</span>
                    <span class="role-card__icon" aria-hidden="true">
                      <svg viewBox="0 0 40 40" fill="none"><path d="M6 24V17a2 2 0 0 1 2-2h14l6 6h4a2 2 0 0 1 2 2v1" stroke="#26352A" stroke-width="1.6"/><path d="M6 24h28" stroke="#26352A" stroke-width="1.6"/><circle cx="13" cy="27" r="3" stroke="#26352A" stroke-width="1.6"/><circle cx="29" cy="27" r="3" stroke="#26352A" stroke-width="1.6"/></svg>
                    </span>
                    <span class="role-card__title">Driver</span>
                    <span class="role-card__desc">Deliver goods and earn on flexible routes</span>
                  </button>
                </div>

                <div class="form__row form__row--between step__nav">
                  <button class="btn btn--text" type="button" data-back>Back</button>
                  <button class="btn btn--dark" type="button" id="roleContinue" disabled>Create Account</button>
                </div>
              </div>

              <!-- STEP 3 : VERIFY EMAIL OTP -->
              <div class="step" data-step="3">
                <h1 class="h1">Verify your email</h1>
                <p class="sub">We've sent a one-time code to <span data-target="email"></span>.</p>

                <div class="verify-block">
                  <div class="verify-block__head">
                    <span class="verify-block__title">Email OTP</span>
                    <span class="verify-badge" data-badge="email">Pending</span>
                  </div>
                  <div class="otp" data-otp="email">
                    <input class="otp__box" maxlength="1" inputmode="numeric">
                    <input class="otp__box" maxlength="1" inputmode="numeric">
                    <input class="otp__box" maxlength="1" inputmode="numeric">
                    <input class="otp__box" maxlength="1" inputmode="numeric">
                    <input class="otp__box" maxlength="1" inputmode="numeric">
                    <input class="otp__box" maxlength="1" inputmode="numeric">
                  </div>
                  <button type="button" class="btn btn--ghost btn--sm" data-verify="email">Verify Email</button>
                </div>

                <div class="form__row form__row--between step__nav">
                  <button class="btn btn--text" type="button" data-back>Back</button>
                  <button class="btn btn--dark" type="button" id="verifyContinue" disabled>Continue</button>
                </div>
              </div>

              <!-- STEP 4 : SUCCESS -->
              <div class="step step--success" data-step="4">
                <div class="success">
                  <span class="success__check" aria-hidden="true">
                    <svg viewBox="0 0 64 64" fill="none">
                      <circle cx="32" cy="32" r="30" fill="#E4F3E6"/>
                      <path class="success__tick" d="M20 33L28 41L45 23" stroke="#218B35" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                    </svg>
                  </span>
                  <h1 class="h1 success__heading">Welcome to Bihari Kisan! <span aria-hidden="true">🌾</span></h1>
                  <p class="sub">Your account has been successfully created.</p>

                  <dl class="summary">
                    <div class="summary__row"><dt>Name</dt><dd id="sumName">—</dd></div>
                    <div class="summary__row"><dt>Role</dt><dd id="sumRole">—</dd></div>
                    <div class="summary__row"><dt>Email</dt><dd id="sumEmail">—</dd></div>
                    <div class="summary__row"><dt>Mobile</dt><dd id="sumMobile">—</dd></div>
                  </dl>

                  <button class="btn btn--dark btn--block" type="button" id="dashboardBtn" href="/buyerDash"
                  >Go to Dashboard</button>
                </div>
              </div>

            </form>
          </div>

        </div>
      </section>

      <!-- RIGHT : VISUAL -->
     
       <div class="visual__art">

    <img 
        src="/photos/registerImg.jpg" 
        alt="Bihari Kisan"
        class="visual__image"
    >

    <div class="visual__overlay"></div>

    <!-- floating info cards -->
    <div class="floaters">
        <div class="floater floater--1">
            <span class="floater__icon">₹</span>
            <span class="floater__text">Better Market Prices</span>
        </div>

        <div class="floater floater--2">
            <span class="floater__icon">✓</span>
            <span class="floater__text">Verified Buyers</span>
        </div>

        <div class="floater floater--3">
            <span class="floater__icon">⚡</span>
            <span class="floater__text">Fast Payments</span>
        </div>

        <div class="floater floater--4">
            <span class="floater__icon">🚚</span>
            <span class="floater__text">Smart Delivery</span>
        </div>
    </div>

</div>
        <div class="visual__caption">
          <p class="visual__quote">"Technology helping farmers earn better."</p>
        </div>
      </aside>

    </div>
  </main>

</div>

<script src="/js/loginJs/register.js"></script>
</body>
</html>
